# App
NODE_ENV=development
PORT=3000
APP_NAME=NestBoot
API_PREFIX=api
API_VERSION=v1
FRONTEND_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestboot?schema=public
DATABASE_POOL_MAX=10

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-me
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Email
EMAIL_TRANSPORT=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=NestBoot

# Webhooks
# JSON array, e.g. [{"name":"provider","secret":"secret","signatureHeader":"x-signature","algorithm":"sha256"}]
WEBHOOK_PROVIDERS=
PAYSTACK_WEBHOOK_SECRET=

# Upload
UPLOAD_DRIVER=local
MAX_FILE_SIZE=10485760
UPLOAD_LOCAL_DEST=./uploads
UPLOAD_PUBLIC_PATH=/uploads
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf
PRESIGNED_URL_EXPIRY=3600

# AWS S3 (only if UPLOAD_DRIVER=s3)
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Error Tracking (optional — install @sentry/node to enable)
SENTRY_DSN=

# Logging (MongoDB — module disabled if MONGO_LOG_URI is empty)
MONGO_LOG_URI=mongodb://localhost:27017/nestboot_logs

# Logging TTLs (in hours)
LOG_TTL_REQUEST=48
LOG_TTL_REQUEST_STATS=2160
LOG_TTL_QUERY=48
LOG_TTL_QUERY_STATS=2160
LOG_TTL_APP=720
LOG_TTL_CRON=168

# Logging Sampling (0.0 - 1.0)
LOG_SAMPLE_RATE=1.0
LOG_SAMPLE_ERROR_RATE=1.0
LOG_SAMPLE_SLOW_RATE=1.0
LOG_SLOW_THRESHOLD=1000

# Query Monitoring
LOG_QUERY_SLOW_THRESHOLD=100
LOG_QUERY_SAMPLE_RATE=1.0

# Buffer Intervals (ms)
LOG_FLUSH_INTERVAL=5000
LOG_AGGREGATION_INTERVAL=300000
