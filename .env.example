# Copy to .env. Every key here is validated by src/platform/config/env.schema.ts;
# the app refuses to start rather than run with a value it cannot make sense of.

NODE_ENV=development

# web = serves HTTP, never executes a workflow
# worker = executes workflows and schedules, serves no HTTP
# all = both, for a laptop or a small deployment
ROLE=all

APP_NAME=nestboot
APP_URL=http://localhost:3000
HOST=0.0.0.0
PORT=3000

# At least 32 characters. Generate one: openssl rand -hex 32
APP_SECRET=change-me-this-is-only-long-enough-for-local-development

# Stamped into every log line and shown in /ops -> Health -> Config.
GIT_SHA=dev

# --- data -------------------------------------------------------------------
# Two databases on one server locally. In production they may be two servers,
# and moving them apart is exactly this: a different URL.
DATABASE_URL=postgres://nestboot:nestboot@localhost:5443/app
OPS_DATABASE_URL=postgres://nestboot:nestboot@localhost:5443/ops
# Optional read replica. db.read() falls back to DATABASE_URL when unset.
# DATABASE_READ_URL=
DATABASE_POOL_SIZE=10
OPS_DATABASE_POOL_SIZE=5
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- observability ----------------------------------------------------------
LOG_LEVEL=debug
LOG_PRETTY=true
OPS_LOGS_ENABLED=true
OPS_REQUESTS_ENABLED=true
# Fraction of ordinary requests recorded (0..1). Errors and slow requests are
# always kept regardless. Turn this down before turning requests off.
OPS_REQUEST_SAMPLE=1
OPS_SLOW_REQUEST_MS=1000

# --- security ---------------------------------------------------------------
# Empty denies every cross-origin request. Never set this to *.
CORS_ORIGINS=
# Must name the load balancer's CIDR in production, or clients forge
# X-Forwarded-For and per-IP rate limiting becomes a global limit.
TRUST_PROXY=
BODY_LIMIT_BYTES=1048576

OPS_ENABLED=true
OPS_PATH=/ops
OPS_IP_ALLOWLIST=
OPS_SESSION_HOURS=12
OPS_MAX_LOGIN_ATTEMPTS=5
OPS_LOCKOUT_MINUTES=15

# --- retention (days) -------------------------------------------------------
RETENTION_LOGS_DAYS=14
RETENTION_REQUESTS_DAYS=30
RETENTION_ERRORS_DAYS=90
RETENTION_SECURITY_DAYS=180
RETENTION_WORKFLOWS_DAYS=30
