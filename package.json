{
  "name": "nestboot",
  "version": "0.1.0",
  "private": true,
  "description": "A NestJS starter whose only opinion is operability.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/src/main.js",
    "migrate": "tsx src/platform/db/migrate.cli.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm depcruise && pnpm test",
    "boot:feature": "tsx src/platform/console/boot.cli.ts feature",
    "boot:action": "tsx src/platform/console/boot.cli.ts action",
    "boot:workflow": "tsx src/platform/console/boot.cli.ts workflow",
    "boot:job": "tsx src/platform/console/boot.cli.ts job",
    "boot:event": "tsx src/platform/console/boot.cli.ts event",
    "boot:listener": "tsx src/platform/console/boot.cli.ts listener",
    "boot:migration": "tsx src/platform/console/boot.cli.ts migration"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "argon2",
      "esbuild",
      "protobufjs"
    ],
    "overrides": {
      "fastify": "5.12.4"
    }
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "4.27.6",
    "@fastify/cookie": "11.1.2",
    "@fastify/formbody": "9.0.0",
    "@fastify/helmet": "13.1.1",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-fastify": "12.0.3",
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "handlebars": "4.7.9",
    "htmx.org": "2.0.10",
    "nestjs-pino": "5.2.0",
    "otplib": "13.5.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuidv7": "1.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@nestjs/testing": "12.0.3",
    "@swc/core": "1.16.2",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "22.19.1",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "18.3.1",
    "pino-pretty": "13.1.3",
    "testcontainers": "12.1.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "unplugin-swc": "1.6.0",
    "vitest": "5.0.1"
  }
}
